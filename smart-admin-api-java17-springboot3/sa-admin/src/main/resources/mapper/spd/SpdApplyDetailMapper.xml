<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.lab1024.sa.admin.module.spd.apply.dao.SpdApplyDetailDao">

    <select id="queryByApplyId" resultType="net.lab1024.sa.admin.module.spd.apply.domain.vo.SpdApplyDetailVO">
        SELECT * FROM t_spd_apply_detail
        WHERE apply_id = #{applyId} AND del_flag = #{delFlag}
        ORDER BY id ASC
    </select>

</mapper>
